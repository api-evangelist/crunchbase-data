{
  "opencollection": "1.0.0",
  "info": {
    "name": "Crunchbase Data API v4 Autocomplete API",
    "version": "4.0"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "user_key",
      "value": "{{user_key}}",
      "placement": "query"
    }
  },
  "items": [
    {
      "info": {
        "name": "Autocomplete",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Autocomplete entities",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.crunchbase.com/v4/data/autocompletes",
            "params": [
              {
                "name": "query",
                "value": "",
                "type": "query",
                "description": "The search string to autocomplete."
              },
              {
                "name": "collection_ids",
                "value": "",
                "type": "query",
                "description": "Comma-separated list of collection ids to scope suggestions to (e.g. organization.companies, principal.investors, categories)."
              },
              {
                "name": "limit",
                "value": "",
                "type": "query",
                "description": "Number of results to return (maximum 25)."
              }
            ]
          },
          "docs": "Suggests matching entities for a query string, optionally scoped to one or more collections (e.g. organization.companies, principal.investors, categories). Commonly used to resolve UUIDs or permalinks for downstream Search or Entity Lookup calls."
        }
      ]
    }
  ],
  "bundled": true
}