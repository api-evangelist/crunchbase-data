      "description": {
        "content": "Detect entities removed from the Crunchbase Graph (deltas).",
        "type": "text/plain"
      },
      "item": [
        {
          "id": "85129f8b-8873-4393-9bac-76ff1fc1e7f0",
          "name": "List deleted entities",
          "request": {
            "name": "List deleted entities",
            "description": {
              "content": "Returns entities removed from the Crunchbase Graph (for example due to compliance, data-quality cleanup, or inappropriate content) so that consumers can detect deletions and reconcile their own databases. Scope to specific collections with collection_ids, sort with deleted_at_order, and page with after_id or before_id.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "deleted_entities"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "collection_ids",
                  "value": "<string>",
                  "description": "Comma-separated list of collection ids to filter by (e.g. organizations, people, funding_rounds, events)."
                },
                {
                  "disabled": false,
                  "key": "deleted_at_order",
                  "value": "<string>",
                  "description": "Sort order for the deleted_at timestamp."
                },
                {
                  "disabled": false,
                  "key": "limit",
                  "value": "<integer>",
                  "description": "Number of items to return per page."
                },
                {
                  "disabled": false,
                  "key": "after_id",
                  "value": "<string>",
                  "description": "Keyset cursor - return items after this entity id."
                },
                {
                  "disabled": false,
                  "key": "before_id",
                  "value": "<string>",
                  "description": "Keyset cursor - return items before this entity id."
                }
              ],
              "variable": []
            },
