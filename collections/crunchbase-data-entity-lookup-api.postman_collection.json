    {
      "id": "18997c72-9097-45aa-81d2-fab98e6f4bd3",
      "name": "Entity Lookup",
      "description": {
        "content": "Retrieve a single entity (and its related cards) by UUID or permalink.",
        "type": "text/plain"
      },
      "item": [
        {
          "id": "fa714a8d-fafe-4971-8fd0-14fbd8b39292",
          "name": "Look up an entity",
          "request": {
            "name": "Look up an entity",
            "description": {
              "content": "Retrieves a single entity from a core collection (organizations, people, funding_rounds, acquisitions, and others) by its UUID or permalink. Use field_ids to select fields and card_ids to include related cards (each card returns at most 100 items).",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "entities",
                ":collection",
                ":entity_id"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "field_ids",
                  "value": "<string>",
                  "description": "Comma-separated list of field ids to return for the entity."
                },
                {
                  "disabled": false,
                  "key": "card_ids",
                  "value": "<string>",
                  "description": "Comma-separated list of related card ids to include. Each card returns a maximum of 100 items; use the card endpoint for more."
                }
              ],
              "variable": [
                {
                  "disabled": false,
                  "type": "any",
                  "value": "<string>",
                  "key": "collection",
                  "description": "(Required) The core entity collection (e.g. organizations, people, funding_rounds, acquisitions)."
                },
                {
                  "disabled": false,
                  "type": "any",
                  "value": "<string>",
                  "key": "entity_id",
                  "description": "(Required) The entity UUID or permalink (e.g. tesla-motors)."
                }
              ]
            },
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "GET",
            "auth": null
