          "request": {
            "name": "Search a collection",
            "description": {
              "content": "Searches a collection (organizations, people, funding_rounds, acquisitions, and others) using a JSON body of field_ids to return and an array of query filters combined with AND logic. Returns 50 items by default and up to 1000 per request, with keyset pagination via after_id or before_id.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "searches",
                ":collection"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [],
              "variable": [
                {
                  "disabled": false,
                  "type": "any",
                  "value": "<string>",
                  "key": "collection",
                  "description": "(Required) The core entity collection (e.g. organizations, people, funding_rounds, acquisitions)."
                }
              ]
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "POST",
            "auth": null,
            "body": {
              "mode": "raw",
              "raw": "{\n  \"field_ids\": [\n    \"<string>\",\n    \"<string>\"\n  ],\n  \"query\": [\n    {\n      \"type\": \"<string>\",\n      \"field_id\": \"<string>\",\n      \"operator_id\": \"<string>\"\n    },\n    {\n      \"type\": \"<string>\",\n      \"field_id\": \"<string>\",\n      \"operator_id\": \"<string>\"\n    }\n  ],\n  \"order\": [\n    {\n      \"field_id\": \"<string>\",\n      \"sort\": \"<string>\"\n    },\n    {\n      \"field_id\": \"<string>\",\n      \"sort\": \"<string>\"\n    }\n  ],\n  \"limit\": 50,\n  \"after_id\": \"<string>\",\n  \"before_id\": \"<string>\"\n}",
